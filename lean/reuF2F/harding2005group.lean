import Mathlib

/-!
# Group-Valued Measures on the Lattice of Closed Subspaces of a Hilbert Space

Authors: John Harding, Ekaterina Jager, and Derek Smith.
Origin: [Lafayette College REU 2003](https://math.lafayette.edu/opportunities/reu/publications/).
Reference: J. Harding, E. Jager, and D. Smith, *Group-Valued Measures on the Lattice of Closed
Subspaces of a Hilbert Space*, Internat. J. Theoret. Phys. **44** (2005), no. 5, 539–548;
doi:10.1007/s10773-005-3981-x.
-/

namespace Harding2005Group

/-- **Question 2** (p. 546). The additive group generated by projections has the universal
extension property of the unigroup of the closed-subspace lattice.

The positive direction follows the expectation on p. 547. The universal property is encoded as
unique additive extension, equivalent to the source's generator-compatible additive isomorphism;
all real Hilbert spaces of dimension at least three and all abelian codomains are retained. -/
theorem question_2
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] (hdim : 3 ≤ Module.rank ℝ H)
    {G : Type*} [AddCommGroup G]
    (f : ClosedSubmodule ℝ H → G)
    (hf : ∀ A B : ClosedSubmodule ℝ H,
      (A : Submodule ℝ H) ≤ (B : Submodule ℝ H)ᗮ →
      f (A ⊔ B) = f A + f B) :
    let P : ClosedSubmodule ℝ H → selfAdjoint (H →L[ℝ] H) :=
      fun A ↦ ⟨(A : Submodule ℝ H).starProjection,
        isSelfAdjoint_starProjection (A : Submodule ℝ H)⟩
    ∃! F : AddSubgroup.closure (Set.range P) →+ G, ∀ A : ClosedSubmodule ℝ H,
      F ⟨P A, AddSubgroup.subset_closure (Set.mem_range_self A)⟩ = f A := by sorry

end Harding2005Group
