/-- Determinant-one representatives of the coset `w_e`. -/
def wCoset (n h e : ℕ) : Set (SL(2, ℝ)) :=
  {g | 0 < e ∧ ∃ a b c d : ℤ,
    Matrix.det !![(a : ℝ) * e, (b : ℝ) / h;
      (c : ℝ) * n, (d : ℝ) * e] = (e : ℝ) ∧
    (g : Matrix (Fin 2) (Fin 2) ℝ) =
      fun i j ↦ (!![(a : ℝ) * e, (b : ℝ) / h;
        (c : ℝ) * n, (d : ℝ) * e] i j) / √e}

/-- The eigengroup generated by its normalized `w_e` cosets. -/
def eigenGroup (r : ℕ × ℕ × Finset ℕ) : Subgroup (SL(2, ℝ)) :=
  Subgroup.closure {g | ∃ e ∈ r.2.2, g ∈ wCoset r.1 r.2.1 e}

/-- The subgroup generated by the Conway-Norton character relations. -/
def characterGraph (r : ℕ × ℕ × Finset ℕ) :
    Subgroup (SL(2, ℝ) × Multiplicative (ZMod r.2.1)) :=
  Subgroup.closure {p |
    (p.1 ∈ wCoset (r.1 * r.2.1) 1 1 ∧ p.2 = 1) ∨
    (∃ A > 0, A ∣ (r.1 * r.2.1) ∧
      Nat.Coprime A (r.1 * r.2.1 / A) ∧
      (∀ l : ℕ, Nat.Prime l → l ∣ A → l ∣ (r.1 / r.2.1)) ∧
      p.1 ∈ wCoset (r.1 * r.2.1) 1 A ∧ p.1 ∈ eigenGroup r ∧ p.2 = 1) ∨
    ((p.1 : Matrix (Fin 2) (Fin 2) ℝ) = !![1, 1 / (r.2.1 : ℝ); 0, 1] ∧
      p.2 = Multiplicative.ofAdd (-1 : ZMod r.2.1)) ∨
    ((p.1 : Matrix (Fin 2) (Fin 2) ℝ) = !![1, 0; (r.1 : ℝ), 1] ∧
      p.2 = Multiplicative.ofAdd
        (if r.1 / r.2.1 ∈ r.2.2 then (1 : ZMod r.2.1) else -1))}

/-- The zero-exponent fiber of the generated character relation, mapped to `GL(2, ℝ)`. -/
def fixingGroup (r : ℕ × ℕ × Finset ℕ) : Subgroup (GL (Fin 2) ℝ) :=
  ((characterGraph r).comap
    (MonoidHom.inl (SL(2, ℝ)) (Multiplicative (ZMod r.2.1)))).map
      Matrix.SpecialLinearGroup.toGL

/-- The Fourier coefficients of the regular part after subtracting `q⁻¹`. -/
def fourierCoefficient (f : UpperHalfPlane → ℂ) (m : ℕ) : ℂ :=
  (UpperHalfPlane.qExpansion 1
    (fun z ↦ f z - (Function.Periodic.qParam 1 (z : ℂ)) ^ (-1 : ℤ))).coeff m

/-- Normalized integral Hauptmodul data for an eigengroup. -/
structure Hauptmodul (r : ℕ × ℕ × Finset ℕ) where
  /-- The underlying function on the upper half-plane. -/
  toFun : UpperHalfPlane → ℂ
  holomorphic : MDiff toFun
  invariant : ∀ g ∈ fixingGroup r,
    ∀ z : UpperHalfPlane, toFun (g • z) = toFun z
  period_one : Function.Periodic (toFun ∘ UpperHalfPlane.ofComplex) 1
  normalized : UpperHalfPlane.IsZeroAtImInfty
    (fun z ↦ toFun z - (Function.Periodic.qParam 1 (z : ℂ)) ^ (-1 : ℤ))
  bounded_other_cusps : ∀ c : OnePoint ℝ,
    IsCusp c (fixingGroup r) →
    (¬∃ g : GL (Fin 2) ℝ,
      g ∈ fixingGroup r ∧ g • (OnePoint.infty : OnePoint ℝ) = c) →
    OnePoint.IsBoundedAt c toFun 0
  integral : ∀ m > 0, ∃ a : ℤ,
    fourierCoefficient toFun m = (a : ℂ)

/-- **Conjecture 4.2** (p. 18). For every prime `p`, if one of the 171 normalized monstrous
Hauptmoduln is uniformly `p`-adically annihilated, then it lies in the `p` column of Table 4.1.

The iteration bound is uniform in the positive Fourier index. -/
theorem conjecture_4_2 (i : Fin 171) (f : Hauptmodul (moonshineGroup i))
    (p : ℕ) (hp : Nat.Prime p)
    (hann : ∀ k ≥ 1, ∃ A ≥ 1,
      ∀ a ≥ A, ∀ m ≥ 1,
        ∃ z : ℤ, fourierCoefficient f.toFun (p ^ a * m) =
          (((p : ℤ) ^ k * z : ℤ) : ℂ)) :
    let allowed : ℕ → Finset ℕ := fun p ↦
      match p with
      | 2 => {0, 1, 2, 3, 5, 6, 7, 8, 9, 10, 12, 14, 17, 20, 21, 22, 23, 24, 25, 28, 29, 33, 34, 36,
        37, 38, 39, 40, 42, 43, 53, 54, 55, 63, 64, 66, 67, 73, 74, 76, 77, 79, 80, 81, 82, 83, 85,
        90, 92, 93, 103, 104, 112, 118, 119, 120, 126, 131, 134, 135, 139, 142, 146, 147, 151, 158,
        159, 162, 167}
      | 3 => {0, 1, 3, 4, 5, 12, 15, 17, 22, 26, 27, 37, 43, 52, 57, 58, 60, 71, 80, 82, 85, 89, 99,
        111, 116, 124, 136, 140, 147, 160, 164}
      | 5 => {0, 1, 3, 5, 7, 10, 11, 12, 17, 18, 22, 25, 28, 30, 37, 49, 52, 53, 64, 71, 81, 86, 96,
        99, 108, 118, 132}
      | 7 => {0, 1, 5, 7, 18, 19, 22, 46, 71, 90}
      | 11 => {0, 5, 7, 33}
      | _ => ∅
    i.val ∈ allowed p := by
  sorry

